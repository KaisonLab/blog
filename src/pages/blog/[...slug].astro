---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		// 최신순 배열이므로 i+1이 더 오래된 글(이전), i-1이 더 새 글(다음)
		props: { post, prev: posts[i + 1], next: posts[i - 1] },
	}));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost post={post} prev={prev} next={next} readingMinutes={readingMinutes(post.body)}>
	<Content />
</BlogPost>
