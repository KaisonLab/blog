---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import avatar from '../assets/brand/avatar.png';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, CATEGORIES } from '../consts';
import Base from './Base.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingMinutes: number;
	prev?: CollectionEntry<'blog'>;
	next?: CollectionEntry<'blog'>;
}
const { post, readingMinutes, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, category, tags } = post.data;
const cat = CATEGORIES[category] ?? { icon: 'notebook', desc: '' };
---

<Base title={title} description={description} type="article" image={heroImage?.src}>
	<main>
		<article>
			<header class="post-head">
				<a class="badge" href={`/categories/${category}/`}><Icon name={cat.icon as any} size={14} /> {category}</a>
				<h1>{title}</h1>
				<p class="desc">{description}</p>
				<div class="meta">
					<Image src={avatar} alt="" width={32} height={32} />
					<span>{AUTHOR.name}</span>
					<span class="dot">·</span>
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<>
								<span class="dot">·</span>
								<span>
									수정 <FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
					<span class="dot">·</span>
					<span>{readingMinutes}분</span>
				</div>
			</header>

			{
				heroImage ? (
					<div class="hero-image">
						<Image src={heroImage} alt="" width={1120} height={560} loading="eager" />
					</div>
				) : (
					<div class="hero-emoji" aria-hidden="true">
						<Icon name={cat.icon as any} size={56} stroke={1.25} />
					</div>
				)
			}

			<div class="prose">
				<slot />
			</div>

			{
				tags.length > 0 && (
					<div class="tags">
						{tags.map((t) => (
							<a class="tag" href={`/tags/${t}/`}>
								#{t}
							</a>
						))}
					</div>
				)
			}

			<nav class="pager">
				{
					prev ? (
						<a class="card" href={`/blog/${prev.id}/`}>
							<small>← 이전 글</small>
							<strong>{prev.data.title}</strong>
						</a>
					) : (
						<span />
					)
				}
				{
					next ? (
						<a class="card right" href={`/blog/${next.id}/`}>
							<small>다음 글 →</small>
							<strong>{next.data.title}</strong>
						</a>
					) : (
						<span />
					)
				}
			</nav>
		</article>
	</main>
</Base>

<style>
	article {
		width: min(760px, 100%);
		margin: 0 auto;
	}
	.post-head {
		text-align: center;
		padding: 36px 0 28px;
	}
	.post-head h1 {
		margin: 16px 0 12px;
	}
	.desc {
		color: var(--muted);
		font-size: 1.05rem;
		margin: 0 0 18px;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 8px;
		font-size: 0.9rem;
		color: var(--text-2);
	}
	.meta img {
		border-radius: 50%;
		border: 1px solid var(--gold-3);
	}
	.dot {
		color: var(--muted);
	}
	.hero-image img {
		border-radius: var(--radius);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		margin: 0 0 36px;
	}
	.hero-emoji {
		height: 180px;
		display: grid;
		place-items: center;
		color: var(--gold);
		border-radius: var(--radius);
		border: 1px solid var(--line);
		background:
			radial-gradient(circle at 30% 30%, rgba(224, 191, 124, 0.18), transparent 55%),
			linear-gradient(135deg, var(--thumb-a), var(--thumb-b));
		margin: 0 0 36px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 40px 0 8px;
	}
	.tag {
		font-size: 0.85rem;
		padding: 4px 10px;
		border-radius: 999px;
		border: 1px solid var(--line-2);
		color: var(--text-2);
	}
	.tag:hover {
		border-color: var(--gold-3);
		color: var(--gold);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		margin-top: 40px;
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 16px 18px;
		color: var(--text);
	}
	.pager a.right {
		text-align: right;
	}
	.pager small {
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.pager {
			grid-template-columns: 1fr;
		}
		.pager a.right {
			text-align: left;
		}
	}
</style>
