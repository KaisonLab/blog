---
import { Image } from 'astro:assets';
import emblem from '../assets/brand/emblem.png';
import { SITE_TITLE, SOCIAL } from '../consts';

interface Props {
	// 홈처럼 히어로 위에 투명하게 얹을지 여부
	overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['site-header', { overlay }]} id="site-header">
	<nav>
		<button class="menu-btn" id="sidebar-open" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="sidebar">
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
				<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h10M4 17h16"></path>
			</svg>
		</button>
		<a class="brand" href="/">
			<Image src={emblem} alt="" width={36} height={36} />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="links">
			<a href="/" class:list={{ active: isActive('/') }}>홈</a>
			<a href="/blog/" class:list={{ active: isActive('/blog') }}>글</a>
			<a href="/categories/" class:list={{ active: isActive('/categories') }}>카테고리</a>
			<a href="/about/" class:list={{ active: isActive('/about') }}>소개</a>
		</div>
		<div class="social">
			<button id="theme-toggle" type="button" aria-label="밝게/어둡게 전환" title="밝게/어둡게">
				<svg class="ic-sun" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 16.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
				</svg>
				<svg class="ic-moon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
				</svg>
			</button>
			<a href={SOCIAL.threads} target="_blank" rel="noopener" aria-label="Threads">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12.2 22c-2.8 0-5-.9-6.5-2.7C4.3 17.7 3.6 15.4 3.5 12.5v-.1c.1-2.9.8-5.2 2.2-6.8C7.2 3.8 9.4 2.9 12.2 2.9c2.2 0 4 .6 5.4 1.8 1.1 1 1.9 2.3 2.4 3.9l-1.9.5c-.7-2.5-2.6-4.1-5.9-4.2-2.2 0-3.9.7-5 2-1.1 1.3-1.6 3.1-1.7 5.6.1 2.5.6 4.3 1.7 5.6 1.1 1.3 2.8 2 5 2 2 0 3.3-.5 4.3-1.5.9-.9 1.1-2 1-2.6-.1-.9-.5-1.6-1.3-2.1-.1 1.2-.5 2.2-1.2 2.9-.8.9-2 1.4-3.5 1.4-1.1 0-2.1-.3-2.9-.9-.9-.7-1.4-1.6-1.4-2.7 0-1.1.5-2 1.4-2.7.8-.6 1.9-.9 3.2-1 .9 0 1.8.1 2.6.3 0-.8-.2-1.4-.6-1.8-.4-.5-1.1-.7-2-.7-1.3 0-2.1.4-2.7 1.2l-1.6-1.1c.9-1.3 2.4-2.1 4.3-2.1 1.5 0 2.7.5 3.5 1.3.8.9 1.2 2.1 1.2 3.6v.4c1.6.8 2.5 2.1 2.7 3.7.2 1.4-.3 3-1.5 4.3-1.4 1.4-3.3 2.1-5.7 2.1Zm-.3-8.6c-1.7.1-2.6.6-2.6 1.6 0 .9.9 1.6 2.3 1.6.9 0 1.6-.3 2.1-.8.5-.5.7-1.3.8-2.2-.8-.2-1.7-.3-2.6-.2Z"
					></path>
				</svg>
			</a>
			<a href={SOCIAL.github} target="_blank" rel="noopener" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--header-bg);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--line);
		transition:
			background 0.3s ease,
			border-color 0.3s ease;
	}
	/* 히어로 위에서는 투명, 스크롤하면 어두워짐 */
	/* 히어로(어두운 그림) 위에 떠 있을 때는 테마와 상관없이 밝은 글자 */
	.site-header.overlay:not(.scrolled) {
		--text: #ece6da;
		--text-2: #c9c2b4;
		--line-2: rgba(236, 230, 218, 0.25);
		--card: rgba(14, 13, 12, 0.35);
	}
	.site-header.overlay {
		position: fixed;
		left: 0;
		right: 0;
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-bottom-color: transparent;
	}
	.site-header.overlay.scrolled {
		background: var(--header-bg);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom-color: var(--line);
	}
	nav {
		width: min(var(--max), calc(100% - 32px));
		margin: 0 auto;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.brand {
		margin-right: auto;
	}
	.menu-btn {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid var(--line-2);
		background: var(--card);
		color: var(--text);
		display: grid;
		place-items: center;
		cursor: pointer;
		flex: none;
		transition:
			color 0.2s,
			border-color 0.2s,
			background 0.2s;
	}
	.menu-btn:hover {
		color: var(--gold);
		border-color: var(--gold);
		background: var(--gold-dim);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: -0.01em;
	}
	.brand img {
		width: 36px;
		height: 36px;
	}
	.links {
		display: flex;
		gap: 4px;
	}
	.links a {
		color: var(--text-2);
		font-weight: 600;
		font-size: 0.95rem;
		padding: 8px 12px;
		border-radius: 999px;
		transition:
			background 0.2s,
			color 0.2s;
	}
	.links a:hover,
	.links a.active {
		color: var(--gold);
		background: var(--gold-dim);
	}
	.social {
		display: flex;
		gap: 6px;
	}
	.social button {
		border: none;
		background: transparent;
		padding: 0;
		cursor: pointer;
	}
	/* 밝은 테마에선 달, 어두운 테마에선 해 */
	.social .ic-sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .social .ic-moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .social .ic-sun {
		display: block;
	}
	.social a,
	.social button {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		color: var(--text-2);
		transition:
			background 0.2s,
			color 0.2s;
	}
	.social a:hover,
	.social button:hover {
		color: var(--gold);
		background: var(--gold-dim);
	}
	@media (max-width: 720px) {
		.brand span {
			display: none;
		}
		.links a {
			padding: 8px 10px;
			font-size: 0.9rem;
		}
		.social a:first-child {
			display: none;
		}
	}
	/* 아주 좁은 화면에선 상단 메뉴를 숨기고 왼쪽 서랍 메뉴만 쓴다 */
	@media (max-width: 420px) {
		.links {
			display: none;
		}
	}
</style>

<script>
	const header = document.getElementById('site-header');
	if (header?.classList.contains('overlay')) {
		const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}

	// 테마 토글. 기본은 밝은 테마, 어두운 테마는 localStorage에 기억한다.
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		if (next === 'dark') root.dataset.theme = 'dark';
		else delete root.dataset.theme;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>
