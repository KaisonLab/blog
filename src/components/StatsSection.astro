---
/*
  홈 통계 섹션 (인파 블로그 구조): 왼쪽 2×2 숫자 카드, 오른쪽 환영 문구.
  총 방문자는 GoatCounter 코드가 있으면 클라이언트에서 가져오고, 없으면 VISITOR_FALLBACK.
*/
import { BLOG_START_DATE, GOATCOUNTER_CODE, PROJECT_COUNT, VISITOR_FALLBACK, WELCOME } from '../consts';
import Icon from './Icon.astro';

interface Props {
	postCount: number;
}
const { postCount } = Astro.props;
const days = Math.max(1, Math.floor((Date.now() - BLOG_START_DATE.valueOf()) / 86400000) + 1);
const welcomeTitle = WELCOME.title.replace(/\{([^}]+)\}/g, '<em>$1</em>');

const stats = [
	{ key: 'visitors', icon: 'users', label: '총 방문자', value: VISITOR_FALLBACK, unit: '명', tone: 1 },
	{ key: 'posts', icon: 'file', label: '총 포스팅', value: postCount, unit: '개', tone: 2 },
	{ key: 'days', icon: 'calendar', label: '블로그 운영', value: days, unit: '일째', tone: 3 },
	{ key: 'projects', icon: 'box', label: '만드는 서비스', value: PROJECT_COUNT, unit: '개', tone: 4 },
] as const;
---

<section id="stats" class="stats-section" data-goat={GOATCOUNTER_CODE}>
	<div class="cards">
		{
			stats.map((s) => (
				<div class:list={['card', 'stat', `tone-${s.tone}`]}>
					<span class="ic"><Icon name={s.icon as any} size={22} /></span>
					<strong>
						<span class="num" data-stat={s.key} data-value={s.value}>
							{s.value.toLocaleString('ko-KR')}
						</span>
						<small>{s.unit}</small>
					</strong>
					<span class="lbl">{s.label}</span>
					<i class="bar" aria-hidden="true"></i>
				</div>
			))
		}
	</div>
	<div class="welcome">
		<h2 set:html={welcomeTitle} />
		<p>{WELCOME.desc}</p>
	</div>
</section>

<style>
	.stats-section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 40px;
		align-items: center;
		padding: 64px 0 8px;
	}
	.cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.stat {
		position: relative;
		overflow: hidden;
		padding: 22px 18px 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		text-align: center;
	}
	.stat .ic {
		color: var(--tone);
		display: grid;
	}
	.stat strong {
		font-family: var(--mono);
		font-weight: 600;
		font-size: 2rem;
		line-height: 1.1;
		color: var(--tone);
		font-variant-numeric: tabular-nums;
	}
	.stat strong small {
		font-family: var(--font);
		font-size: 0.85rem;
		font-weight: 600;
		margin-left: 3px;
		color: var(--tone);
		opacity: 0.85;
	}
	.stat .lbl {
		color: var(--text-2);
		font-size: 0.9rem;
		font-weight: 600;
	}
	.stat .bar {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 5px;
		background: var(--tone);
	}
	.tone-1 {
		--tone: var(--c-1);
	}
	.tone-2 {
		--tone: var(--c-2);
	}
	.tone-3 {
		--tone: var(--c-3);
	}
	.tone-4 {
		--tone: var(--c-4);
	}
	.welcome {
		text-align: center;
		padding: 0 8px;
	}
	.welcome h2 {
		font-size: clamp(1.7rem, 3.4vw, 2.4rem);
		line-height: 1.3;
		margin-bottom: 14px;
	}
	.welcome h2 :global(em) {
		font-style: normal;
		color: var(--gold);
	}
	.welcome p {
		color: var(--text-2);
		margin: 0 auto;
		max-width: 40ch;
	}
	@media (max-width: 860px) {
		.stats-section {
			grid-template-columns: 1fr;
			gap: 28px;
			padding-top: 40px;
		}
		.welcome {
			order: -1;
		}
	}
	@media (max-width: 420px) {
		.cards {
			gap: 10px;
		}
		.stat {
			padding: 16px 10px 18px;
		}
		.stat strong {
			font-size: 1.6rem;
		}
	}
</style>

<script>
	// GoatCounter 공개 카운터: https://<code>.goatcounter.com/counter/TOTAL.json → { count: "1 234" }
	const sec = document.getElementById('stats');
	const code = sec?.dataset.goat;
	const el = sec?.querySelector<HTMLElement>('[data-stat="visitors"]');
	if (code && el) {
		fetch(`https://${code}.goatcounter.com/counter/TOTAL.json`)
			.then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
			.then((j) => {
				const n = Number(String(j.count).replace(/[^\d]/g, ''));
				if (Number.isFinite(n)) el.textContent = n.toLocaleString('ko-KR');
			})
			.catch(() => {});
	}
</script>
